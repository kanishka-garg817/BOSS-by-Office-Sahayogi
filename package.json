{
  "name": "boss",
  "version": "0.0.0",
  "private": true,
  "description": "BOSS by Office Sahayogi — website monorepo",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck",
    "db:generate": "pnpm --filter @boss/db db:generate",
    "db:migrate": "pnpm --filter @boss/db db:migrate",
    "db:studio": "pnpm --filter @boss/db db:studio"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.11.9",
    "typescript": "6.0.3"
  }
}
