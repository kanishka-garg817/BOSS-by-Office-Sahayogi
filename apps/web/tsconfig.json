{
  "extends": "@boss/config/tsconfig/nextjs.json",
  "compilerOptions": {
    "types": ["node", "react", "react-dom"],
    "paths": {
      "@/*": ["./src/*"],
      "@boss/ui": ["../../packages/ui/src/index.ts"],
      "@boss/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", "**/*.mjs", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
