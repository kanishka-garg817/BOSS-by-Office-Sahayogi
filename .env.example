# Copy to `.env` and fill in real values. Never commit `.env`.
# One file at the repo root is read by the web app and the db package.

# Deployment environment: development | staging | production
# Anything other than "production" is served with noindex and a disallow-all robots.txt.
APP_ENV=development

# Public origin of the site, no trailing slash. Used for canonical URLs, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Play listing URL of the BoSS Android app. Required in production: until it is set the
# mobile app page offers "Book a Demo" there. Outside production the button opens the Play Store home.
# NEXT_PUBLIC_PLAY_STORE_URL=

# PostgreSQL connection string (server-only).
DATABASE_URL=postgresql://boss:change-me@localhost:5432/boss_dev
