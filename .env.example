# Copy to `.env` and fill in real values. Never commit `.env`.
# One file at the repo root is read by the web app and the db package.

# Deployment environment: development | staging | production
# Anything other than "production" is served with noindex and a disallow-all robots.txt.
APP_ENV=development

# Public origin of the site, no trailing slash. Used for canonical URLs, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Play listing URL of the BoSS Android app. Required in production: until it is set the
# mobile app page offers "Book a Demo" there. Outside production the button opens the Play Store home.
# NEXT_PUBLIC_PLAY_STORE_URL=

# PostgreSQL connection string (server-only).
DATABASE_URL=postgresql://boss:change-me@localhost:5432/boss_dev

# --- Demo requests (the Book a Demo form) ---
# Each request is sent to your email and to WhatsApp. Set up one or both. With neither set, the
# form works in development (the request is only logged) and shows an error in production.

# Email through Resend (https://resend.com). Set all three or none.
# RESEND_API_KEY=
# LEADS_EMAIL_FROM=BoSS <demo@your-domain>
# LEADS_EMAIL_TO=you@your-domain,teammate@your-domain

# WhatsApp through the WhatsApp Business Cloud API (Meta). Set the first four or none.
# Create a message template with five body variables and have it approved in WhatsApp Manager:
#   New BoSS demo request.
#   Name: {{1}}
#   Company: {{2}}
#   Phone: {{3}}
#   Email: {{4}}
#   Message: {{5}}
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_RECIPIENT=919876543210
# WHATSAPP_TEMPLATE_NAME=new_demo_request
# WHATSAPP_TEMPLATE_LANGUAGE=en
